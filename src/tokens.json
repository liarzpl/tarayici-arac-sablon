{
  "meta": {
    "name": "Fikir Fabrikası — genel şablon token'ları",
    "scope": "GENEL (sablon/tarayici-arac). Ürüne özel override'lar tasarim/urunler/ altında tutulur.",
    "version": "1.0.0",
    "date": "2026-10-05",
    "defaultTheme": "dark",
    "source": ["tasarim/ANTI_SLOP.md", "tasarim/tokens.css", "tasarim/referanslar.md"],
    "cssPrefix": "--",
    "notes": "Değerler tokens.css ile birebir aynıdır; birini değiştiren diğerini de günceller. Harici font/CDN yok (CSP font-src 'self')."
  },
  "color": {
    "dark": {
      "bg": "#0e1116",
      "surface": "#161b22",
      "surface-2": "#1c232d",
      "text": "#e6edf3",
      "muted": "#8b98a9",
      "border": "#262e3a",
      "border-strong": "#364152",
      "accent": "#2563eb",
      "accent-hover": "#1d4ed8",
      "accent-text": "#7aa7ff",
      "accent-subtle": "rgb(37 99 235 / 0.16)",
      "on-accent": "#ffffff",
      "success": "#3fb950",
      "success-subtle": "rgb(63 185 80 / 0.14)",
      "danger": "#f85149",
      "danger-hover": "#da3633",
      "danger-subtle": "rgb(248 81 73 / 0.14)",
      "warning": "#d29922",
      "warning-subtle": "rgb(210 153 34 / 0.16)",
      "focus": "#60a5fa"
    },
    "light": {
      "bg": "#f7f8fa",
      "surface": "#ffffff",
      "surface-2": "#f1f3f6",
      "text": "#111318",
      "muted": "#5b6675",
      "border": "#e3e7ed",
      "border-strong": "#cfd5dd",
      "accent": "#2563eb",
      "accent-hover": "#1d4ed8",
      "accent-text": "#1d4ed8",
      "accent-subtle": "rgb(37 99 235 / 0.08)",
      "on-accent": "#ffffff",
      "success": "#1a7f37",
      "success-subtle": "rgb(26 127 55 / 0.08)",
      "danger": "#cf222e",
      "danger-hover": "#a40e26",
      "danger-subtle": "rgb(207 34 46 / 0.08)",
      "warning": "#9a6700",
      "warning-subtle": "rgb(154 103 0 / 0.1)",
      "focus": "#2563eb"
    }
  },
  "typography": {
    "font": {
      "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem"
    },
    "leading": {
      "tight": 1.25,
      "snug": 1.375,
      "normal": 1.5,
      "relaxed": 1.625
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "tracking": {
      "tight": "-0.011em",
      "normal": "0"
    },
    "roles": {
      "display": { "size": "2xl", "weight": "semibold", "leading": "tight", "tracking": "tight", "note": "Sayfada tek h1" },
      "title": { "size": "lg", "weight": "semibold", "leading": "snug", "tracking": "tight", "note": "Kart/bölüm başlığı (h2)" },
      "body": { "size": "base", "weight": "regular", "leading": "normal" },
      "small": { "size": "sm", "weight": "regular", "leading": "normal", "note": "Tablo, buton, yardımcı metin" },
      "caption": { "size": "xs", "weight": "medium", "leading": "normal", "color": "muted" },
      "mono": { "family": "mono", "size": "sm", "weight": "regular", "leading": "normal", "note": "URL, kod, sayı kolonları" }
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "7": "1.75rem",
    "8": "2rem",
    "9": "2.25rem",
    "10": "2.5rem",
    "11": "2.75rem",
    "12": "3rem"
  },
  "layout": {
    "content-max": "880px",
    "content-narrow": "640px",
    "page-pad-x": "{space.4}",
    "card-pad": "{space.5}",
    "section-gap": "{space.6}",
    "control-height": "2.25rem"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "full": "9999px"
  },
  "border": {
    "width": "1px"
  },
  "shadow": {
    "dark": {
      "sm": "0 1px 2px rgb(0 0 0 / 0.4)",
      "md": "0 4px 12px rgb(0 0 0 / 0.45)"
    },
    "light": {
      "sm": "0 1px 2px rgb(16 24 40 / 0.06)",
      "md": "0 4px 12px rgb(16 24 40 / 0.08)"
    }
  },
  "focus": {
    "ring-width": "2px",
    "ring-offset": "2px",
    "ring": "0 0 0 2px {color.bg}, 0 0 0 4px {color.focus}"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "160ms",
      "slow": "200ms"
    },
    "easing": {
      "out": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "maxDuration": "200ms",
    "reducedMotion": "prefers-reduced-motion: reduce → tüm süreler 0ms"
  }
}
